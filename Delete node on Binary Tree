import java.util.*;

class Node {
    int data;
    Node left;
    Node right;

    Node(int data) {
        this.data = data;
        left = null;
        right = null;
    }
}

public class Main {

    Node root;

    void create() {
        Scanner sc = new Scanner(System.in);

        int val = sc.nextInt();

        if (val == -1) {
            root = null;
            return;
        }

        root = new Node(val);

        Queue<Node> queue = new LinkedList<>();
        queue.add(root);

        while (!queue.isEmpty()) {
            Node cur = queue.poll();

            int left_val = sc.nextInt();
            if (left_val != -1) {
                cur.left = new Node(left_val);
                queue.add(cur.left);
            }

            int right_val = sc.nextInt();
            if (right_val != -1) {
                cur.right = new Node(right_val);
                queue.add(cur.right);
            }
        }
    }

    void levelorder(Node root) {
        if (root == null)
            return;

        Queue<Node> q = new LinkedList<>();
        q.add(root);

        while (!q.isEmpty()) {
            Node cur = q.poll();

            System.out.println(cur.data);

            if (cur.left != null)
                q.add(cur.left);

            if (cur.right != null)
                q.add(cur.right);
        }
    }
    
    void del(int key){
        
        if(root == null){
            return;
        }
        if(root.left == null && root.right == null){
            if(root.data == key){
                root = null;
            }
            return;
        }
        Node cur;
        Node tar = null;
        Queue<Node> q = new LinkedList<>();
        q.add(root);

        while(!q.isEmpty()){
            cur = q.remove();
            
            if(cur.data == key){
                tar = cur;
            }
            if(cur.left != null){
                q.add(cur.left);
            }
            if(cur.right != null){
                q.add(cur.right);
            }
        }
        if(tar != null){
            tar.data = cur.data;
            depest(cur);
        }
        
    }

    void depest(Node dep_leaf){
        Queue<Node> q = new LinkedList<>();
        q.add(root);

        while(!q.isEmpty()){
            Node cur = q.remove();
            if(cur.left != null){
                if(cur.left == dep_leaf){
                    cur.left = null;
                    return;
                }
                q.add(cur.left);
            }
            if(cur.right != null){
                if(cur.right == dep_leaf){
                    cur.right = null;
                    return;
                }
                q.add(cur.right);
            }
        }
    }

    public static void main(String[] args) {

        Main tree = new Main();

        tree.create();

        System.out.println("Before Delete:");
        tree.levelorder(tree.root);

        tree.del(30);

        System.out.println("\nAfter Delete:");

        tree.levelorder(tree.root);
    }
}
